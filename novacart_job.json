{
  "name": "novacart case study job",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_work",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/1NOVACART-CASE-STUDY/bronze_work",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "silver_work",
      "depends_on": [
        {
          "task_key": "bronze_work"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/1NOVACART-CASE-STUDY/silver_work",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "gold_work",
      "depends_on": [
        {
          "task_key": "silver_work"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/1NOVACART-CASE-STUDY/gold_work",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "novacart_dashboard",
      "depends_on": [
        {
          "task_key": "gold_work"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "dashboard_task": {
        "subscription": {
          "attachment": {
            "page_attachment": {}
          }
        },
        "dashboard_id": "REPLACE_WITH_DASHBOARD_ID"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "n_alert",
      "depends_on": [
        {
          "task_key": "novacart_dashboard"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "sql_task": {
        "alert": {
          "alert_id": "REPLACE_WITH_ALERT_ID",
          "subscriptions": []
        },
        "warehouse_id": "REPLACE_WITH_WAREHOUSE_ID"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED"
}
