{
  "datasets": [
    {
      "name": "0599ac0f",
      "displayName": "orders_information",
      "config": {
        "version": "1.1",
        "source": "adb_datatocrunchproject.gold_schema.orders_information",
        "dimensions": [
          {
            "expr": "order_id"
          },
          {
            "expr": "customer_id"
          },
          {
            "expr": "product_name"
          },
          {
            "expr": "category"
          },
          {
            "expr": "order_status"
          },
          {
            "expr": "payment_status"
          },
          {
            "expr": "payment_state"
          },
          {
            "expr": "order_date"
          },
          {
            "expr": "order_year"
          },
          {
            "name": "order_month_date",
            "expr": "DATE_TRUNC('MONTH', order_date)",
            "displayName": "Order Month"
          }
        ],
        "measures": [
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT order_id)",
            "displayName": "Total Orders"
          },
          {
            "name": "gmv",
            "expr": "SUM(order_amount)",
            "displayName": "Gross Merchandise Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_paid",
            "expr": "SUM(paid_amount)",
            "displayName": "Total Paid",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "unique_customers",
            "expr": "COUNT(DISTINCT customer_id)",
            "displayName": "Unique Customers"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(order_amount) / COUNT(DISTINCT order_id)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "payment_completion_rate",
            "expr": "SUM(paid_amount) / NULLIF(SUM(order_amount), 0)",
            "displayName": "Payment Completion Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "7fd76ae1",
      "displayName": "category_performance",
      "config": {
        "version": "1.1",
        "source": "adb_datatocrunchproject.gold_schema.category_performance",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
